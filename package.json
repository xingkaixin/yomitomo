{
  "name": "yomitomo",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "turbo dev",
    "dev:app": "pnpm --filter @yomitomo/desktop dev",
    "dev:app:debug": "YOMITOMO_OPEN_DEVTOOLS=1 pnpm --filter @yomitomo/desktop dev",
    "dev:web": "pnpm --filter @yomitomo/web dev",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs",
    "licenses:check": "node scripts/generate-third-party-notices.mjs --check",
    "docs:check-paths": "node scripts/check-doc-paths.mjs",
    "effect:check": "node scripts/check-effect-v4.mjs",
    "ui:check-primitives": "node scripts/check-ui-primitives.mjs",
    "make": "pnpm run make:app:mac-arm",
    "make:app:mac-arm": "pnpm --filter @yomitomo/desktop make:mac-arm",
    "make:app:mac-arm:from-dist": "pnpm --filter @yomitomo/desktop make:mac-arm:from-dist",
    "make:app:win-x64": "pnpm --filter @yomitomo/desktop make:win-x64",
    "make:app:win-x64:from-dist": "pnpm --filter @yomitomo/desktop make:win-x64:from-dist",
    "deploy:cf": "pnpm --filter @yomitomo/web deploy:cf",
    "deploy:download": "pnpm --filter @yomitomo/download deploy:cf",
    "deploy:telemetry": "pnpm --filter @yomitomo/telemetry deploy:cf",
    "build": "turbo build",
    "build:app": "pnpm --filter @yomitomo/desktop build",
    "build:web": "pnpm --filter @yomitomo/web build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "test": "turbo test",
    "test:app:e2e": "pnpm --filter @yomitomo/desktop test:e2e",
    "test:app:e2e:from-dist": "pnpm --filter @yomitomo/desktop test:e2e:from-dist",
    "test:app:e2e:ui": "pnpm --filter @yomitomo/desktop test:e2e:ui",
    "gate:check": "node scripts/check-gate-docs.mjs"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "jsdom": "^30.1.1",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "turbo": "^2.11.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
