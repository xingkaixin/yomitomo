{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    "no-await-in-loop": "off",
    "typescript/consistent-return": "off",
    "typescript/no-unsafe-type-assertion": "off",
    "unicorn/consistent-function-scoping": "off",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "react",
            "importNames": [
              "useState",
              "useEffect",
              "useLayoutEffect",
              "useInsertionEffect"
            ],
            "message": "Use useReducer for local state, zustand or TanStack Query for shared state, and the hooks listed in docs/renderer-state.md for effects."
          }
        ]
      }
    ],
    "no-restricted-properties": [
      "error",
      {
        "object": "React",
        "property": "useState",
        "message": "Use useReducer for local state, zustand or TanStack Query for shared state, and the hooks listed in docs/renderer-state.md for effects."
      },
      {
        "object": "React",
        "property": "useEffect",
        "message": "Use useReducer for local state, zustand or TanStack Query for shared state, and the hooks listed in docs/renderer-state.md for effects."
      },
      {
        "object": "React",
        "property": "useLayoutEffect",
        "message": "Use useReducer for local state, zustand or TanStack Query for shared state, and the hooks listed in docs/renderer-state.md for effects."
      },
      {
        "object": "React",
        "property": "useInsertionEffect",
        "message": "Use useReducer for local state, zustand or TanStack Query for shared state, and the hooks listed in docs/renderer-state.md for effects."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/__tests__/**"
      ],
      "rules": {
        "no-restricted-imports": "off",
        "no-restricted-properties": "off"
      }
    },
    {
      "files": [
        "apps/desktop/src/renderer/src/shell/use-desktop-event.ts",
        "apps/web/src/components/landing/use-stable-callback.ts",
        "packages/reader-ui/src/hooks/use-event-listener.ts",
        "packages/reader-ui/src/hooks/use-interval.ts",
        "packages/reader-ui/src/hooks/use-mount-effect.ts",
        "packages/reader-ui/src/hooks/use-stable-callback.ts"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.next/**",
    "**/.turbo/**",
    "**/.wxt/**",
    "**/.vite/**",
    "**/.cache/**",
    "**/.temp/**",
    "**/dist/**",
    "**/out/**",
    "**/build/**",
    "**/coverage/**",
    "**/vendor/foliate-js/**",
    "public/scripts/**"
  ]
}
