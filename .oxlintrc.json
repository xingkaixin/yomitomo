{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    "no-await-in-loop": "off",
    "typescript/consistent-return": "off",
    "typescript/no-unsafe-type-assertion": "off",
    "unicorn/consistent-function-scoping": "off",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "react",
            "importNames": [
              "useState",
              "useEffect",
              "useLayoutEffect",
              "useInsertionEffect"
            ],
            "message": "Use useReducer for local state, zustand or TanStack Query for shared state, and the hooks listed in docs/renderer-state.md for effects."
          }
        ]
      }
    ],
    "no-restricted-properties": [
      "error",
      {
        "object": "React",
        "property": "useState",
        "message": "Use useReducer for local state, zustand or TanStack Query for shared state, and the hooks listed in docs/renderer-state.md for effects."
      },
      {
        "object": "React",
        "property": "useEffect",
        "message": "Use useReducer for local state, zustand or TanStack Query for shared state, and the hooks listed in docs/renderer-state.md for effects."
      },
      {
        "object": "React",
        "property": "useLayoutEffect",
        "message": "Use useReducer for local state, zustand or TanStack Query for shared state, and the hooks listed in docs/renderer-state.md for effects."
      },
      {
        "object": "React",
        "property": "useInsertionEffect",
        "message": "Use useReducer for local state, zustand or TanStack Query for shared state, and the hooks listed in docs/renderer-state.md for effects."
      }
    ]
  },
  "overrides": [
