{
  "name": "@yomitomo/desktop",
  "version": "0.14.1",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "pnpm run rebuild:native && electron-vite dev --watch",
    "build": "pnpm run rebuild:native && node scripts/verify-native-roots.mjs && electron-vite build && pnpm run dist:verify",
    "dist:verify": "node scripts/verify-desktop-dist.mjs",
    "embedding:smoke:packaged": "node scripts/smoke-packaged-embedding.mjs",
    "reading-memory:test-fixtures": "vitest run --config e2e/packaged/unit.vitest.config.ts",
    "reading-memory:acceptance": "node scripts/reading-memory-acceptance.mjs",
    "make:mac-arm": "pnpm run build && pnpm run make:mac-arm:from-dist",
    "make:mac-arm:from-dist": "pnpm run dist:verify && node scripts/verify-native-roots.mjs && electron-builder --config electron-builder.config.cjs --config.directories.output=../../dist/app/mac-arm64 --mac --arm64 --publish never",
    "make:win-x64": "pnpm run build && pnpm run make:win-x64:from-dist",
    "make:win-x64:from-dist": "pnpm run dist:verify && node scripts/verify-native-roots.mjs && electron-builder --config electron-builder.config.cjs --config.directories.output=../../dist/app/win-x64 --win --x64 --publish never",
    "db:generate": "drizzle-kit generate",
    "native:install": "pnpm --dir electron-native install --package-import-method=copy",
    "rebuild:native": "pnpm run native:install && node scripts/rebuild-electron-native.mjs && node scripts/prepare-native-macos.mjs",
    "native:verify": "pnpm run rebuild:native && node scripts/verify-native-roots.mjs",
    "test:e2e": "pnpm run build && pnpm run test:e2e:from-dist",
    "test:e2e:from-dist": "pnpm run dist:verify && vitest run --config e2e/vitest.config.ts e2e/tests/desktop-smoke.test.ts && vitest run --config e2e/vitest.config.ts e2e/tests/electron-launch-smoke.test.ts",
    "test:e2e:ui": "vitest run --config e2e/ui/vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p e2e/tsconfig.json --noEmit",
    "lint": "oxlint . --type-aware",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --write \"**/*.{ts,tsx,js,jsx,json,css,html}\"",
    "format:check": "oxfmt --check \"**/*.{ts,tsx,js,jsx,json,css,html}\"",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@embedpdf/engines": "2.15.0",
    "@embedpdf/models": "2.15.0",
    "@embedpdf/pdfium": "2.15.0",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@huggingface/transformers": "4.2.0",
    "@napi-rs/keyring": "^1.3.0",
    "drizzle-orm": "^0.45.2",
    "effect": "4.0.0-beta.98",
    "electron-updater": "^6.8.9",
    "jsdom": "^30.0.1",
    "jszip": "^3.10.1",
    "undici": "8.10.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@base-ui/react": "^1.7.0",
    "@dnd-kit/dom": "0.5.0",
    "@dnd-kit/react": "0.5.0",
    "@electron/rebuild": "^4.2.0",
    "@embedpdf/core": "2.15.0",
    "@embedpdf/plugin-bookmark": "2.15.0",
    "@embedpdf/plugin-document-manager": "2.15.0",
    "@embedpdf/plugin-interaction-manager": "2.15.0",
    "@embedpdf/plugin-render": "2.15.0",
    "@embedpdf/plugin-scroll": "2.15.0",
    "@embedpdf/plugin-selection": "2.15.0",
    "@embedpdf/plugin-viewport": "2.15.0",
    "@embedpdf/plugin-zoom": "2.15.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@yomitomo/ai": "workspace:*",
    "@yomitomo/core": "workspace:*",
    "@yomitomo/reader-ui": "workspace:*",
    "@yomitomo/shared": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-kit": "^0.31.10",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-builder-squirrel-windows": "^26.15.3",
    "electron-vite": "^5.0.0",
    "framer-motion": "^13.1.1",
    "goey-toast": "^0.5.0",
    "i18next": "^26.4.0",
    "input-otp": "^1.5.0",
    "playwright-core": "^1.62.1",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
