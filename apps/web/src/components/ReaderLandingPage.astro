---
import desktopPackage from '../../../desktop/package.json';
import Analytics from './Analytics.astro';
import LandingMasthead from './landing/LandingMasthead.astro';
import HeroSection from './landing/HeroSection.astro';
import MobileProductPreview from './landing/MobileProductPreview.astro';
import DemoSection from './landing/DemoSection.astro';
import StepsSection from './landing/StepsSection.astro';
import AgentsSection from './landing/AgentsSection.astro';
import FeaturesSection from './landing/FeaturesSection.astro';
import GuidesSection from './landing/GuidesSection.astro';
import FaqSection from './landing/FaqSection.astro';
import DownloadSection from './landing/DownloadSection.astro';
import LandingFooter from './landing/LandingFooter.astro';
import { getFaqItems } from './landing/faq-data';
import { githubUrl, xUrl, youtubeUrl } from '../site-links';
import { buildLandingStructuredData, siteUrl } from '../structured-data';
import '../styles/landing.css';

type Props = {
  lang?: 'zh-CN' | 'en' | 'ja';
};

const { lang = 'zh-CN' } = Astro.props;
const isEnglish = lang === 'en';
const isJapanese = lang === 'ja';
const skipLinkLabel = isEnglish
  ? 'Skip to main content'
  : isJapanese
    ? 'メインコンテンツへ移動'
    : '跳到主要内容';

const releaseVersion = desktopPackage.version;
const releaseBaseUrl = `https://download.yomitomo.app/releases/download/v${releaseVersion}`;
const downloads = {
  version: releaseVersion,
  mac: `${releaseBaseUrl}/Yomitomo-${releaseVersion}-mac-arm64.dmg`,
  windows: `${releaseBaseUrl}/Yomitomo-${releaseVersion}-win-x64.exe`,
};

const localeUrls = {
  'zh-CN': `${siteUrl}/`,
  en: `${siteUrl}/en/`,
  ja: `${siteUrl}/ja/`,
};
const canonicalUrl = localeUrls[lang];
const defaultLocaleUrl = `${siteUrl}/`;
const pageTitle = isEnglish
  ? 'Yomitomo — Open-source AI Reader for PDF & EPUB'
  : isJapanese
    ? 'Yomitomo — PDF・EPUBに対応した無料のAI読書アプリ'
    : 'Yomitomo：免费开源 AI 阅读器，支持 PDF、EPUB 与网页批注';
const pageDescription = isEnglish
  ? 'Read PDF, EPUB and web articles on macOS and Windows. Highlight passages, discuss them with AI, and keep notes locally. Free and open source; bring your own model.'
  : isJapanese
    ? 'PDF・EPUB・Web記事を読み、原文に注釈を付けてAIと対話。読書メモは端末内に保存。macOS・Windows対応の無料オープンソースアプリです。AIには自分のAPIキーやローカルモデルを使えます。'
    : '用 Yomitomo 阅读 PDF、EPUB 和网页文章，在原文划线、记笔记并与 AI 讨论，支持微信读书笔记同步。免费开源，适用于 macOS 和 Windows，阅读数据保存在本机，AI 可使用自备 API 或本地模型。';
const ogImageUrl = `${siteUrl}/assets/og-image.jpg`;
const faqItems = getFaqItems(lang);
const jsonLd = buildLandingStructuredData({
  canonicalUrl,
  description: pageDescription,
  downloads,
  faqItems,
  language: lang,
  sameAs: [githubUrl, xUrl, youtubeUrl],
  title: pageTitle,
  version: releaseVersion,
});
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="description" content={pageDescription} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonicalUrl} />
    {
      Object.entries(localeUrls).map(([locale, url]) => (
        <link rel="alternate" hreflang={locale} href={url} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={defaultLocaleUrl} />
    <link rel="icon" type="image/png" sizes="64x64" href="/assets/favicon.png" />
    <link
      rel="preload"
      as="image"
      type="image/webp"
      href="/assets/backgrounds/reading-focus.webp"
      fetchpriority="high"
    />
    <noscript>
      <style>
        .reveal {
          opacity: 1;
          transform: none;
        }
      </style>
    </noscript>

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={isEnglish ? 'en_US' : isJapanese ? 'ja_JP' : 'zh_CN'} />
    <meta property="og:site_name" content="Yomitomo" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="theme-color" content="#fbf9f3" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    <Analytics />
  </head>
  <body>
    <div class="lp-root">
      <a class="lp-skip-link" href="#main-content">{skipLinkLabel}</a>
      <LandingMasthead lang={lang} active="home" />
      <main id="main-content" tabindex="-1">
        <HeroSection lang={lang} version={downloads.version} />
        <MobileProductPreview lang={lang} />
        <DemoSection lang={lang} />
        <div class="reveal"><StepsSection lang={lang} /></div>
        <div class="reveal"><AgentsSection lang={lang} /></div>
        <div class="reveal"><FeaturesSection lang={lang} /></div>
        <GuidesSection lang={lang} />
        <div class="reveal"><FaqSection lang={lang} /></div>
        <div class="reveal"><DownloadSection lang={lang} downloads={downloads} /></div>
      </main>
      <LandingFooter lang={lang} />
    </div>

    <script is:inline>
      const reveals = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('in');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12 },
        );
        for (const el of reveals) io.observe(el);
      } else {
        for (const el of reveals) el.classList.add('in');
      }
    </script>
  </body>
</html>
