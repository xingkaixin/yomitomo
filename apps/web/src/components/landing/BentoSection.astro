        <div class="c k-right d7" style="left: 134px; top: 6px; width: 110px; height: 126px; box-shadow: 0 0 0 1px rgba(155, 70, 59, 0.5), 0 10px 24px -10px rgba(47, 39, 32, 0.34)"><div class="a stack" style="inset: 16px 12px; gap: 9px"><span class="b h" style="width: 54%"></span><span class="b k-wipe d9" style="width: 100%"></span><span class="b k-wipe d10" style="width: 88%"></span><span class="b y k-wipe d11" style="width: 66%"></span></div></div>
      </div>
    </div>
