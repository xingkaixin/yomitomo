---
import { githubUrl } from '../../site-links';
import { getHomeCopy, type CompanionId, type Lang } from './home-copy';

type Props = {
  lang?: Lang;
};

const { lang = 'zh-CN' } = Astro.props;
const copy = getHomeCopy(lang).bento;
const prefix = lang === 'en' ? '/en' : lang === 'ja' ? '/ja' : '';
const avatar = (id: CompanionId) => `/assets/landing-avatars/${lang}/${id}-96.webp`;
---

<section class="wrap feat">
  <h2 class="sec-title">{copy.title}</h2>
  <div class="bento">
  <a class="tile is-wide" data-tile="src" href={`${prefix}/docs/library/`}>
    <div class="art" aria-hidden="true">
      <span class="chipi"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path pathLength="1" d="M3 3.5h4v11H3zM7 3.5h4v11H7z"></path><path pathLength="1" d="m11.5 4 3.5 1-2.7 9.5-3.3-1"></path></svg></span>
      <div class="sc">
        <span class="lbl k-left d1" style="left: 0; top: 2px; width: 74px"><svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.1"><circle cx="6" cy="6" r="4.5"></circle><path d="M1.5 6h9M6 1.5c2.5 2.8 2.5 6.2 0 9M6 1.5c-2.5 2.8-2.5 6.2 0 9"></path></svg>WEB</span>
        <span class="lbl k-left d2" style="left: 0; top: 37px; width: 74px"><svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.1"><path d="M2 2.5c1.5-.7 3-.7 4 .2 1-.9 2.5-.9 4-.2v7c-1.5-.7-3-.7-4 .2-1-.9-2.5-.9-4-.2zM6 2.7v7"></path></svg>EPUB</span>
        <span class="lbl k-left d3" style="left: 0; top: 72px; width: 74px"><svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.1"><path d="M2.5 1.5h5l2 2v7h-7zM7.5 1.5v2h2"></path></svg>PDF</span>
        <span class="lbl k-left d4" style="left: 0; top: 107px; width: 74px"><svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.1"><path d="M2.5 2h7M2.5 4.5h7M2.5 7h5M2.5 9.5h3"></path></svg>TXT</span>
        <span class="lbl k-left d5" style="left: 0; top: 142px; width: 74px"><svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.1"><path d="M1.5 2.5 6 4l4.5-1.5v7L6 11 1.5 9.5zM6 4v7"></path></svg>WEREAD</span>
        <svg class="line k-draw d6" width="60" height="168" viewBox="0 0 60 168" style="left: 74px; top: 0"><path pathLength="1" d="M2 15 C 30 15, 26 84, 56 84"></path><path pathLength="1" d="M2 50 C 30 50, 26 84, 56 84"></path><path pathLength="1" d="M2 85 H 56"></path><path pathLength="1" d="M2 120 C 30 120, 26 84, 56 84"></path><path pathLength="1" d="M2 155 C 30 155, 26 84, 56 84"></path></svg>
        <div class="c k-pop d7" style="left: 132px; top: 22px; width: 124px; height: 124px">
          <span class="a b h" style="left: 12px; top: 13px; width: 46px"></span>
          <div class="a k-rise d9" style="left: 12px; top: 30px; right: 12px; display: flex; gap: 8px"><span style="width: 13px; height: 18px; border-radius: 2px; background: var(--tint)"></span><div class="stack" style="flex: 1; gap: 5px; padding-top: 2px"><span class="b" style="width: 100%"></span><span class="b" style="width: 60%"></span></div></div>
          <div class="a k-rise d10" style="left: 12px; top: 58px; right: 12px; display: flex; gap: 8px"><span style="width: 13px; height: 18px; border-radius: 2px; background: #4b7fb5"></span><div class="stack" style="flex: 1; gap: 5px; padding-top: 2px"><span class="b" style="width: 86%"></span><span class="b" style="width: 48%"></span></div></div>
          <div class="a k-rise d11" style="left: 12px; top: 86px; right: 12px; display: flex; gap: 8px"><span style="width: 13px; height: 18px; border-radius: 2px; background: var(--hl-deep)"></span><div class="stack" style="flex: 1; gap: 5px; padding-top: 2px"><span class="b" style="width: 94%"></span><span class="b" style="width: 40%"></span></div></div>
        </div>
      </div>
    </div>
    <h3>{copy.src.title}</h3>
    <p>{copy.src.desc}</p>
  </a>

  <a class="tile is-wide" data-tile="anchor" href={`${prefix}/docs/reader/`}>
    <div class="art" aria-hidden="true">
      <span class="chipi"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path pathLength="1" d="m3 12.5.6-2.5 7-7a1.5 1.5 0 0 1 2.1 2.1l-7 7z"></path><path pathLength="1" d="M3 15.5c2-1 3 .9 5 0s3 .9 5 0"></path></svg></span>
      <div class="sc">
        <div class="c" style="left: 0; top: 10px; width: 140px; height: 148px">
          <div class="a stack" style="left: 14px; right: 14px; top: 16px; gap: 10px">
            <span class="b h" style="width: 56%"></span><span class="b" style="width: 100%"></span><span class="b" style="width: 92%"></span>
            <span class="b" style="width: 100%; background: var(--bar-strong)"></span>
            <span class="b" style="width: 84%"></span><span class="b" style="width: 96%"></span><span class="b" style="width: 40%"></span>
          </div>
          <svg class="line y k-draw d2" width="112" height="8" viewBox="0 0 112 8" style="left: 14px; top: 76px"><path pathLength="1" d="M0 4 q 3.5 -5 7 0 t 7 0 t 7 0 t 7 0 t 7 0 t 7 0 t 7 0 t 7 0 t 7 0 t 7 0 t 7 0 t 7 0 t 7 0 t 7 0 t 7 0 t 7 0"></path></svg>
        </div>
        <svg class="line y k-draw d6" width="44" height="30" viewBox="0 0 44 30" style="left: 126px; top: 52px"><path pathLength="1" d="M2 26 C 16 26, 22 8, 40 6 m-5 -4 l5 4 l-5 4"></path></svg>
        <div class="c k-pop d8" style="left: 168px; top: 34px; width: 88px; height: 92px; background: var(--r-mat)">
          <span class="ctab t k-fade d9"></span>
          <div class="a stack k-rise d9" style="left: 8px; right: 8px; top: 8px; bottom: 8px; padding: 10px 9px; border-radius: 5px; background: var(--card); gap: 7px"><span class="b h" style="width: 100%"></span><span class="b" style="width: 72%"></span><span class="b" style="width: 42%; margin-top: 8px"></span></div>
        </div>
      </div>
    </div>
    <h3>{copy.anchor.title}</h3>
    <p>{copy.anchor.desc}</p>
  </a>

  <a class="tile" data-tile="ask" href={`${prefix}/docs/ai-companions/`}>
    <div class="art" aria-hidden="true">
      <span class="chipi"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle pathLength="1" cx="9" cy="9" r="3"></circle><path pathLength="1" d="M12 6v4.2a2 2 0 0 0 3.8.8 7 7 0 1 0-2.5 3.5"></path></svg></span>
      <div class="sc">
        <div class="c" style="left: 24px; top: 4px; width: 208px; height: 160px">
          <span class="a b h" style="left: 14px; top: 16px; width: 104px"></span>
          <span class="a b" style="left: 14px; top: 29px; width: 150px"></span>
          <span class="a k-pop d2" style="left: 14px; top: 44px; padding: 2px 7px; border-radius: 5px; background: var(--r-mat); color: var(--r-accent); font: 700 10px/1.4 var(--mono)">@</span>
          <span class="dot k-pop d3" style="left: 14px; top: 74px; width: 24px; height: 24px"><img src={avatar('question-mentor')} alt="" width="24" height="24" loading="lazy" /></span>
          <div class="a stack k-wipe d5" style="left: 48px; top: 77px; width: 142px; gap: 6px"><span class="b" style="width: 100%"></span><span class="b" style="width: 64%"></span></div>
          <span class="dot k-pop d7" style="left: 14px; top: 116px; width: 24px; height: 24px"><img src={avatar('root-reviewer')} alt="" width="24" height="24" loading="lazy" /></span>
          <div class="a stack k-wipe d9" style="left: 48px; top: 119px; width: 142px; gap: 6px"><span class="b" style="width: 92%"></span><span class="b y" style="width: 52%"></span></div>
        </div>
      </div>
    </div>
    <h3>{copy.ask.title}</h3>
    <p>{copy.ask.desc}</p>
  </a>

  <a class="tile" data-tile="keep" href={`${prefix}/docs/sedimentation/`}>
    <div class="art" aria-hidden="true">
      <span class="chipi"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path pathLength="1" d="M9 2.5 2.5 6 9 9.5 15.5 6z"></path><path pathLength="1" d="m2.5 9.5 6.5 3.5 6.5-3.5"></path><path pathLength="1" d="m2.5 12.5 6.5 3.5 6.5-3.5"></path></svg></span>
      <div class="sc">
        <div class="c ghost k-merge d1" style="--x: -66px; --y: -18px; --r: -7deg; left: 74px; top: 44px; width: 108px; height: 62px"><div class="a stack" style="inset: 14px 12px; gap: 7px"><span class="b" style="width: 100%"></span><span class="b" style="width: 60%"></span></div></div>
        <div class="c ghost k-merge d2" style="--x: 70px; --y: -24px; --r: 6deg; left: 74px; top: 44px; width: 108px; height: 62px"><div class="a stack" style="inset: 14px 12px; gap: 7px"><span class="b" style="width: 88%"></span><span class="b" style="width: 72%"></span></div></div>
        <div class="c ghost k-merge d3" style="--x: 2px; --y: 54px; --r: 3deg; left: 74px; top: 44px; width: 108px; height: 62px"><div class="a stack" style="inset: 14px 12px; gap: 7px"><span class="b" style="width: 96%"></span><span class="b" style="width: 44%"></span></div></div>
        <div class="c k-pop d12" style="left: 48px; top: 30px; width: 160px; height: 112px; background: var(--r-mat); box-shadow: 0 0 0 1px rgba(155, 70, 59, 0.5), 0 10px 24px -10px rgba(47, 39, 32, 0.34)">
          <span class="ctab t" style="width: 50px"></span>
          <div class="a stack" style="inset: 8px; padding: 14px 12px; border-radius: 5px; background: var(--card); gap: 9px"><span class="b h" style="width: 62%"></span><span class="b" style="width: 100%"></span><span class="b" style="width: 92%"></span><span class="b y k-wipe d13" style="width: 70%"></span></div>
        </div>
      </div>
    </div>
    <h3>{copy.keep.title}</h3>
    <p>{copy.keep.desc}</p>
  </a>

  <a class="tile" data-tile="lang" href={`${prefix}/docs/reader/`}>
    <div class="art" aria-hidden="true">
      <span class="chipi"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path pathLength="1" d="M3 4.5h7M6.5 3v1.5M9 4.5c-.6 3-2.8 5.3-5.5 6.3"></path><path pathLength="1" d="M5 7c.8 1.6 2.2 3 4 3.8"></path><path pathLength="1" d="m9.5 15 2.7-6 2.8 6M10.5 13.3h3.5"></path></svg></span>
