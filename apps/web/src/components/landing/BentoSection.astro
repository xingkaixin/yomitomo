    <p>{copy.review.desc}</p>
  </a>

  <a class="tile" data-tile="stats" href={`${prefix}/docs/stats-and-faq/`}>
    <div class="art" aria-hidden="true">
      <span class="chipi"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path pathLength="1" d="M3 15.5h12"></path><path pathLength="1" d="M5 12.5v-4M9 12.5v-9M13 12.5v-6"></path></svg></span>
      <div class="sc">
        <div class="c" style="left: 24px; top: 4px; width: 208px; height: 160px">
          <span class="a b h" style="left: 16px; top: 16px; width: 62px"></span>
          <div class="a" style="left: 16px; right: 16px; bottom: 16px; height: 104px; display: flex; align-items: flex-end; gap: 9px">
            <span class="k-up d1" style="flex: 1; height: 34%; border-radius: 3px; background: var(--bar)"></span>
            <span class="k-up d2" style="flex: 1; height: 58%; border-radius: 3px; background: var(--bar)"></span>
            <span class="k-up d3" style="flex: 1; height: 44%; border-radius: 3px; background: var(--bar)"></span>
            <span class="k-up d4" style="flex: 1; height: 72%; border-radius: 3px; background: var(--bar)"></span>
            <span class="k-up d5" style="flex: 1; height: 52%; border-radius: 3px; background: var(--bar)"></span>
            <span class="k-up d6" style="flex: 1; height: 80%; border-radius: 3px; background: var(--bar)"></span>
