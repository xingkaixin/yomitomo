          <div class="a stack" style="left: 16px; right: 16px; top: 18px; gap: 7px">
            <span class="b h" style="width: 100%"></span><span class="b" style="width: 82%; background: var(--r-accent-soft)"></span>
            <span class="b h" style="width: 90%; margin-top: 7px"></span><span class="b" style="width: 96%; background: var(--r-accent-soft)"></span>
            <span class="b h" style="width: 100%; margin-top: 7px"></span><span class="b" style="width: 58%; background: var(--r-accent-soft)"></span>
          </div>
        </div>
        <div class="a" style="left: 28px; top: 4px; width: 200px; height: 160px; pointer-events: none">
          <span class="a k-wipe d4" style="left: 16px; top: 30px; width: 138px; height: 5px; border-radius: 3px; background: var(--r-accent)"></span>
          <span class="a k-wipe d6" style="left: 16px; top: 69px; width: 162px; height: 5px; border-radius: 3px; background: var(--r-accent)"></span>
          <span class="a k-wipe d8" style="left: 16px; top: 108px; width: 98px; height: 5px; border-radius: 3px; background: var(--r-accent)"></span>
        </div>
      </div>
    </div>
    <h3>{copy.lang.title}</h3>
    <p>{copy.lang.desc}</p>
  </a>

  <a class="tile is-wide" data-tile="mem" href={`${prefix}/docs/settings/`}>
    <div class="art" aria-hidden="true">
      <span class="chipi"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle pathLength="1" cx="4.5" cy="9" r="2"></circle><circle pathLength="1" cx="13.5" cy="4.5" r="2"></circle><circle pathLength="1" cx="13.5" cy="13.5" r="2"></circle><path pathLength="1" d="m6.3 8.1 5.4-2.7M6.3 9.9l5.4 2.7"></path></svg></span>
      <div class="sc">
        <div class="c" style="left: 0; top: 46px; width: 100px; height: 80px"><div class="a stack" style="inset: 16px 12px; gap: 8px"><span class="b" style="width: 100%"></span><span class="b y" style="width: 76%"></span><span class="b" style="width: 54%"></span></div></div>
        <svg class="line t k-draw d3" width="70" height="168" viewBox="0 0 70 168" style="left: 96px; top: 0"><path pathLength="1" d="M4 82 C 34 82, 30 34, 64 34"></path><path pathLength="1" d="M4 82 C 34 82, 30 136, 64 136"></path></svg>
        <div class="c k-right d6" style="left: 160px; top: 0; width: 96px; height: 70px"><div class="a stack" style="inset: 14px 11px; gap: 8px"><span class="b y" style="width: 86%"></span><span class="b" style="width: 100%"></span><span class="b" style="width: 40%"></span></div></div>
        <div class="c k-right d8" style="left: 160px; top: 98px; width: 96px; height: 70px"><div class="a stack" style="inset: 14px 11px; gap: 8px"><span class="b" style="width: 92%"></span><span class="b y" style="width: 64%"></span><span class="b" style="width: 72%"></span></div></div>
      </div>
    </div>
    <h3>{copy.mem.title}</h3>
    <p>{copy.mem.desc}</p>
  </a>

  <a class="tile is-wide" data-tile="lib" href={`${prefix}/docs/settings/`}>
    <div class="art" aria-hidden="true">
      <span class="chipi"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle pathLength="1" cx="9" cy="9" r="6.5"></circle><path pathLength="1" d="M6.8 7a2.3 2.3 0 1 1 3.5 2c-.8.5-1.3 1-1.3 1.7"></path><path pathLength="1" d="M9 13v.1"></path></svg></span>
      <div class="sc">
        <div class="c k-rise" style="left: 0; top: 2px; width: 164px; height: 32px; border-radius: 16px"><span class="a b h k-wipe d2" style="left: 16px; top: 13px; width: 106px"></span></div>
        <div class="c k-rise d5" style="left: 0; top: 46px; width: 164px; height: 118px">
          <div class="a stack" style="left: 14px; right: 14px; top: 14px; gap: 8px"><span class="b k-wipe d6" style="width: 100%"></span><span class="b k-wipe d7" style="width: 86%"></span><span class="b k-wipe d8" style="width: 62%"></span></div>
          <span class="a k-pop d9" style="left: 14px; bottom: 14px; width: 42px; height: 18px; border-radius: 5px; background: var(--r-mat); box-shadow: 0 0 0 1px #e3c4bb"></span>
          <span class="a k-pop d10" style="left: 62px; bottom: 14px; width: 42px; height: 18px; border-radius: 5px; background: var(--r-mat); box-shadow: 0 0 0 1px #e3c4bb"></span>
        </div>
        <svg class="line t k-draw d11" width="60" height="50" viewBox="0 0 60 50" style="left: 58px; top: 116px; overflow: visible"><path pathLength="1" d="M12 30 C 40 62, 100 40, 118 8 m-1 8 l1 -8 l-8 3"></path></svg>
        <div class="c k-right d12" style="left: 176px; top: 44px; width: 80px; height: 104px"><div class="a stack" style="inset: 14px 10px; gap: 8px"><span class="b" style="width: 100%"></span><span class="b" style="width: 78%"></span><span class="b y" style="width: 100%"></span><span class="b" style="width: 58%"></span></div></div>
      </div>
    </div>
    <h3>{copy.lib.title}</h3>
    <p>{copy.lib.desc}</p>
  </a>

  <a class="tile" data-tile="review" href={`${prefix}/docs/`}>
    <div class="art" aria-hidden="true">
      <span class="chipi"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path pathLength="1" d="M3 9a6 6 0 1 0 1.8-4.3L3 6.5"></path><path pathLength="1" d="M3 3v3.5h3.5"></path><path pathLength="1" d="M9 6v3l2 1.5"></path></svg></span>
