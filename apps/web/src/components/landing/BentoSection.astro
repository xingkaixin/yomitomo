    <p>{copy.stats.desc}</p>
  </a>

  <a class="tile" data-tile="theme" href={`${prefix}/docs/settings/`}>
    <div class="art" aria-hidden="true">
      <span class="chipi"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle pathLength="1" cx="9" cy="9" r="6.5"></circle><path pathLength="1" d="M9 2.5a6.5 6.5 0 0 1 0 13"></path></svg></span>
      <div class="sc">
        <div class="a" style="left: 24px; top: 8px; width: 208px; height: 152px; overflow: hidden; border-radius: 10px; box-shadow: 0 0 0 1px rgba(47, 39, 32, 0.08), 0 10px 22px -12px rgba(47, 39, 32, 0.3); background: #fffdf8">
          <div class="a stack" style="left: 12px; top: 20px; width: 46px; gap: 8px"><span class="b h" style="width: 80%"></span><span class="b" style="width: 100%"></span><span class="b" style="width: 72%"></span><span class="b" style="width: 90%"></span></div>
