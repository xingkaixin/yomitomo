---
type Props = {
  lang?: 'zh-CN' | 'en' | 'ja';
};

const { lang = 'zh-CN' } = Astro.props;
const isEnglish = lang === 'en';
const isJapanese = lang === 'ja';

const copy = isJapanese
  ? {
      kicker: 'デスクトップ読書ワークスペース',
      title: '原文を読み、根拠に線を引き、その場で対話する。',
      caption:
        'YomitomoはmacOSとWindowsのデスクトップアプリです。記事、線、対話を一つの読書ワークスペースに保ちます。',
      alt: '原文の線とサイドバーの対話カードがつながったYomitomoデスクトップリーダー',
      enlarge: '画像を拡大して見る',
    }
  : isEnglish
    ? {
      kicker: 'Desktop reading workspace',
      title: 'Read the source. Mark the evidence. Discuss it in context.',
      caption:
        'Yomitomo is a macOS and Windows desktop app. Articles, highlights, and discussions stay in one reading workspace.',
      alt: 'Yomitomo desktop reader with source highlights connected to a discussion card',
      enlarge: 'View full-size image',
      }
    : {
      kicker: '桌面端阅读工作台',
      title: '读文章，画线，再讨论。',
      caption:
        'Yomitomo 是 macOS 与 Windows 桌面应用。文章、画线与讨论始终在同一阅读工作台中。',
      alt: 'Yomitomo 桌面阅读器，原文划线连接到边栏讨论卡片',
      enlarge: '查看完整大图',
      };

const previewBase = isEnglish || isJapanese ? '/assets/en-reader' : '/assets/cn-reader';
const previewSrcset = [640, 960, 1280, 1600]
  .map((width) => `${previewBase}-${width}.webp ${width}w`)
  .join(', ');
---

<section class="mobile-product-preview" aria-labelledby="mobile-preview-title">
  <div class="lp-container">
    <div class="mobile-preview-heading">
      <p class="sec-kicker">{copy.kicker}</p>
      <h2 id="mobile-preview-title">{copy.title}</h2>
    </div>
    <figure class="mobile-preview-window">
      <a class="mobile-preview-scene" href={`${previewBase}-2400.webp`}>
        <img
          class="mobile-preview-image"
          src={`${previewBase}-1600.webp`}
          srcset={previewSrcset}
          sizes="(max-width: 640px) calc(100vw - 42px), calc(100vw - 66px)"
          width="1600"
          height="1032"
          loading="lazy"
          decoding="async"
          alt={copy.alt}
        />
        <span class="mobile-preview-enlarge">{copy.enlarge}</span>
      </a>
      <figcaption>{copy.caption}</figcaption>
    </figure>
  </div>
</section>
