---
type Props = {
  lang?: 'zh-CN' | 'en' | 'ja';
};

const { lang = 'zh-CN' } = Astro.props;
const isEnglish = lang === 'en';
const isJapanese = lang === 'ja';

const features = isJapanese
  ? [
      {
        title: 'ローカルファースト',
        desc: '記事、注釈、対話はローカルに保存し、APIキーはOSの資格情報ストアで管理します。リモートAIを使うと、関連する内容が設定したモデルの接続先へ送信されます。',
      },
      {
        title: '無料・オープンソース',
        desc: 'YomitomoはMITライセンスで公開された完全無料のオープンソースです。コンテンツの押しつけも、並べ替えも、読書データの販売もしません。',
      },
      {
        title: '複数のソースを一つの机へ',
        desc: '異なるソースの本文、線、対話を一つのワークスペースに集約します。同期したメモも原文の位置を保ちます。',
        tags: ['Web記事', 'PDF', 'EPUB', '微信読書'],
      },
    ]
  : isEnglish
    ? [
      {
        title: 'Local-first',
        desc: 'Articles, annotations and discussions are stored locally, with API keys in the OS keystore. Remote AI requests send relevant content to your configured model endpoint.',
      },
      {
        title: 'Open & free',
        desc: 'Yomitomo is completely free and open source under the MIT license. It never pushes to you, never reorders for you, and never sells your reading.',
      },
      {
        title: 'Many sources, one desk',
        desc: 'Content from different sources—your lines and discussions all land on the same workbench, and synced notes keep their original anchors.',
        tags: ['Web articles', 'PDF', 'EPUB', 'WeRead'],
      },
      ]
    : [
      {
        title: '本地优先',
        desc: '文章、批注与讨论保存在本机，API Key 由系统凭据库保管。使用远程 AI 时，相关内容会发送到你配置的模型端点。',
      },
      {
        title: '开源免费',
        desc: 'Yomitomo 完全免费、开源，在 MIT 协议下。它不向你推送，不替你排序，也不把你的阅读卖给任何人。',
      },
      {
        title: '多来源汇集',
        desc: '不同来源的内容，划线和讨论都落在同一个工作台里，同步过来的笔记也会保留原文锚点。',
        tags: ['网页文章', 'PDF', 'EPUB', '微信读书'],
      },
      ];
---

<section class="section">
  <div class="lp-container">
    <div class="feat-trio">
      {
        features.map((feat) => (
          <div class="feat">
            <h3>{feat.title}</h3>
            <p>{feat.desc}</p>
            {feat.tags && (
              <div class="src-tags">
                {feat.tags.map((tag) => (
                  <span>{tag}</span>
                ))}
              </div>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>
