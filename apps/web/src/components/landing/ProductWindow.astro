---
import { bookSpines, getHomeCopy, type CompanionId, type Lang } from './home-copy';

type Props = {
  lang?: Lang;
};

const { lang = 'zh-CN' } = Astro.props;
const { window: w, band } = getHomeCopy(lang);
const avatar = (id: CompanionId) => `/assets/landing-avatars/${lang}/${id}-96.webp`;
const root = band.companions['root-reviewer'];
const insight = band.companions['insight-editor'];
const question = band.companions['question-mentor'];
---

<div class="win">
  <div class="lights" aria-hidden="true"><i></i><i></i><i></i></div>
  <div class="win-track" data-flow-track>

  <div class="view" data-view="read" style="--i: 0">
      <div class="w-bar">
        <span class="w-back"><svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M9 2.5 4.5 7 9 11.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>{w.library}</span>
        <div class="w-title"><b>{w.article.title}</b><span>{w.article.byline}</span></div>
        <svg class="w-open" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M10 3H4.5A1.5 1.5 0 0 0 3 4.5v9A1.5 1.5 0 0 0 4.5 15h9a1.5 1.5 0 0 0 1.5-1.5V8M11 7l4-4m0 0h-3.2M15 3v3.2" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        <div class="w-progress"><i></i></div>
      </div>
      <div class="r-tools" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="2" y="3" width="12" height="10" rx="2" stroke="currentColor" stroke-width="1.4"></rect><path d="M6 3v10" stroke="currentColor" stroke-width="1.4"></path></svg><s></s>
        <svg width="15" height="15" viewBox="0 0 15 15" fill="none"><path d="M2.5 12.5 3 10l6.8-6.8a1.4 1.4 0 0 1 2 2L5 12z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"></path></svg>
        <span>2/3</span><s></s>
        <svg width="15" height="15" viewBox="0 0 15 15" fill="none"><circle cx="6.5" cy="6.5" r="4.5" stroke="currentColor" stroke-width="1.4"></circle><path d="m10 10 3 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path></svg><s></s>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="6.3" stroke="currentColor" stroke-width="1.3"></circle><path d="M5 6h6M8 4.6V6M10 6c-.4 2-2 3.6-4.2 4.4M6.6 7.4c.7 1.5 1.9 2.5 3.6 3" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"></path></svg><s></s>
        <span>Aa</span><s></s>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M1.5 8h13M4 5.5 1.5 8 4 10.5M12 5.5 14.5 8 12 10.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </div>
      <div class="rv">
        <div class="rail rail-left">
          <section class="note note-dist pop-card pop-2" style="top: 76px">
            <span class="note-tab"><svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M6 1 1 3.5 6 6l5-2.5L6 1ZM1 6l5 2.5L11 6M1 8.5 6 11l5-2.5" stroke="currentColor" stroke-width="1" stroke-linejoin="round"></path></svg>{w.tabs.distill}</span>
            <div class="note-body">
              <p>{w.distillBody[0]}</p>
              <p style="margin-top: 8px">{w.distillBody[1]}</p>
              <footer>{w.time.twoDaysAgo}</footer>
            </div>
          </section>
        </div>

        <div class="r-article">
          <h2>{w.article.title}</h2>
          <p>{w.article.paragraphs[0]}</p>
          <p>{w.article.paragraphs[1]}<span class="hl is-active" data-anchor-line>{w.article.quote}</span></p>
          <p class="is-extra"><span class="hl">{w.article.quote2}</span>{w.article.paragraphs[2]}</p>
          <p>{w.selection.before}<span class="sel-a"><i class="sel sel-h"></i></span><span class="sel">{w.selection.text}</span><span class="sel-end"><i class="sel sel-h"></i><span class="s-menu" aria-hidden="true"><span class="is-extra">{w.menu.copy}<kbd>C</kbd></span><span class="is-primary">{w.menu.note}<kbd>A</kbd></span><span>{w.menu.ask}<kbd>Q</kbd></span><span class="is-extra">{w.menu.related}</span></span></span>{w.selection.after}</p>
          <p>{w.article.paragraphs[3]}</p>
          <p>{w.article.paragraphs[4]}</p>
        </div>

        <div class="rail rail-right">
          <section class="note note-back" style="top: 212px">
            <span class="note-tab">{w.tabs.note}</span>
            <div class="note-body"><p class="note-quote">{w.article.quote2}</p><div class="note-meta"><span class="av">{w.me}</span>{w.me}<time>{w.time.yesterday}</time></div><div class="note-foot">1</div></div>
          </section>
          <section class="note is-active pop-card pop-1" style="top: 196px">
            <span class="note-tab">{w.tabs.note}</span>
            <div class="note-body">
              <p class="note-quote">{w.article.quote}</p>
              <div class="note-meta"><span class="av">{w.me}</span>{w.me}<time>{w.time.threeMinutes}</time></div>
              <div class="note-foot">
                <span class="avs" style="padding-left: 6px"><span class="av"><img src={avatar('question-mentor')} alt="" width="96" height="96" loading="lazy" /></span><span class="av"><img src={avatar('root-reviewer')} alt="" width="96" height="96" loading="lazy" /></span></span>
                {w.noteCount}
                <span class="note-open"><svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M7 1.5C3.8 1.5 1.5 3.7 1.5 6.5c0 1.2.4 2.2 1.2 3.1L2.2 12.5l3-1.1c.5.1 1.1.2 1.8.2 3.2 0 5.5-2.2 5.5-5s-2.3-5.1-5.5-5.1Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"></path></svg>{w.openDiscussion}</span>
              </div>
            </div>
          </section>
        </div>
        <svg class="wire" width="100" height="60" viewBox="0 0 100 60" fill="none" aria-hidden="true" data-wire><path pathLength="1" d="M2 52 C 26 56, 40 12, 72 10 m-7 -5 l7 5 l-7 5"></path></svg>
      </div>
      <div class="help" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="7.5" stroke="currentColor" stroke-width="1.4"></circle><path d="M7.8 7.8a2.3 2.3 0 1 1 3.5 2c-.8.5-1.3 1-1.3 1.8M10 14.2v.1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path></svg><b>Q</b></div>
    </div>

  <div class="view" data-view="think" style="--i: 1" hidden>
      <div class="w-mini">{w.discussionTitle} - {w.article.quote}</div>
      <div class="d-quote"><small>{w.discussingLine}</small><p>{w.article.quote}</p></div>
      <div class="d-main">
        <aside class="d-side">
          <div class="d-head">{w.thoughts} <span>3</span><i class="d-plus" aria-hidden="true">+</i></div>
          <div class="idea is-on"><span class="av">{w.me}</span><div><b>{w.me}</b><span>{w.thoughtList.me}</span><small>{w.thoughtList.meMeta}</small></div></div>
          <div class="idea"><span class="av"><img src={avatar('root-reviewer')} alt="" width="96" height="96" loading="lazy" /></span><div><b>{root.name}</b><span>{w.thoughtList.root}</span><small>{w.thoughtList.rootMeta}</small></div></div>
          <div class="idea"><span class="av"><img src={avatar('insight-editor')} alt="" width="96" height="96" loading="lazy" /></span><div><b>{insight.name}</b><span>{w.thoughtList.insight}</span><small>{w.time.justNow}</small></div></div>
          <div class="d-commit">{w.commit}</div>
        </aside>
        <div class="d-thread">
          <div class="d-head">{w.discussion}<span class="d-seg" aria-hidden="true"><i>{w.layoutSplit}</i><i>{w.layoutLeft}</i></span></div>
          <article class="msg"><span class="av">{w.me}</span><div><header>{w.me}<time>{w.time.threeMinutes}</time></header><p>{w.messages.meAsk} <mark>@{question.name}</mark> <mark>@{root.name}</mark></p></div></article>
          <article class="msg"><span class="av"><img src={avatar('question-mentor')} alt="" width="96" height="96" loading="lazy" /></span><div><header>{question.name}<time>{w.time.twoMinutes}</time></header><p>{w.messages.question}</p></div></article>
          <article class="msg"><span class="av"><img src={avatar('root-reviewer')} alt="" width="96" height="96" loading="lazy" /></span><div><header>{root.name}<time>{w.time.twoMinutes}</time></header><p>{w.messages.root}</p></div></article>
          <article class="msg"><span class="av">{w.me}</span><div><header>{w.me}<time>{w.time.justNow}</time></header><p>{w.messages.meReply}</p></div></article>
          <div class="composer">
            <span>{w.composer}</span>
            <footer><span class="avs"><span class="av"><img src={avatar('reading-partner')} alt="" width="96" height="96" loading="lazy" /></span><span class="av"><img src={avatar('question-mentor')} alt="" width="96" height="96" loading="lazy" /></span><span class="av"><img src={avatar('insight-editor')} alt="" width="96" height="96" loading="lazy" /></span><span class="av"><img src={avatar('root-reviewer')} alt="" width="96" height="96" loading="lazy" /></span><span class="av"><img src={avatar('concept-translator')} alt="" width="96" height="96" loading="lazy" /></span><span class="av"><img src={avatar('structure-navigator')} alt="" width="96" height="96" loading="lazy" /></span></span><em>{w.reply}</em></footer>
          </div>
        </div>
      </div>
    </div>

  <div class="view" data-view="keep" style="--i: 2" hidden>
      <div class="w-mini">{w.distillTitle} - {w.article.quote}</div>
      <div class="s-main">
        <div class="s-doc">
          <div class="d-head">{w.distillDraft} <span class="chip">{w.draft}</span><span class="s-publish">{w.publish}</span></div>
          <h3>{w.doc.title}</h3>
          <p>{w.doc.first}</p>
          <p>{w.doc.before}<del>{w.doc.removed}</del><ins>{w.doc.added}</ins>{w.doc.end}</p>
          <div class="s-prop"><span class="av"><img src={avatar('root-reviewer')} alt="" width="96" height="96" loading="lazy" /></span>{w.proposal}<u>{w.accept}</u><u>{w.ignore}</u></div>
          <p style="margin-top: 22px">{w.doc.last}</p>
          <p class="s-source">{w.doc.source}</p>
        </div>
        <div class="d-thread s-doc-right">
          <div class="d-head">{w.reviewTitle}<span class="d-seg" aria-hidden="true"><i>{w.layoutSplit}</i><i>{w.layoutLeft}</i></span></div>
          <article class="msg"><span class="av"><img src={avatar('root-reviewer')} alt="" width="96" height="96" loading="lazy" /></span><div><header>{root.name}<time>{w.time.justNow}</time></header><p>{w.review.rootOne}</p><p>{w.review.rootTwo}</p></div></article>
          <article class="msg"><span class="av"><img src={avatar('insight-editor')} alt="" width="96" height="96" loading="lazy" /></span><div><header>{insight.name}<time>{w.time.justNow}</time></header><p>{w.review.insight}</p></div></article>
          <div class="composer">
            <span>{w.reviewComposer}</span>
            <footer><span class="avs"><span class="av"><img src={avatar('root-reviewer')} alt="" width="96" height="96" loading="lazy" /></span><span class="av"><img src={avatar('insight-editor')} alt="" width="96" height="96" loading="lazy" /></span></span><em>{w.send}</em></footer>
          </div>
        </div>
      </div>
    </div>

  <div class="view" data-view="lib" style="--i: 3" hidden>
      <div class="l-mast">
        <strong>Yomitomo</strong>
        <nav aria-hidden="true">{
            w.libraryNav.map((item, index) => (
              <span class:list={[index === 0 && 'is-on']}>{item}</span>
            ))
          }</nav>
      </div>
      <div class="l-search">
        <div class="l-input"><b>{w.all}</b><span>{w.search}</span></div>
        <i class="l-add" aria-hidden="true">+</i>
      </div>
      <div class="l-grid">
        {
          w.books.map((book, index) => (
            <div class="l-card" style={`animation-delay: ${index * 40}ms`}>
              <div class="cover" style={`--spine: ${bookSpines[index]}`}>{book.title}</div>
              <div class="l-body">
                <small>{book.author}</small>
                <b>{book.title}</b>
                <div class="l-meta">{book.date}<i>{book.kind}</i><span>{book.counts}</span></div>
              </div>
            </div>
          ))
        }
      </div>
      <div class="l-foot"><span>{w.total}</span><span class="l-pages" aria-hidden="true"><i class="is-on">1</i><i>2</i><i>3</i></span><span>{w.perPage}</span></div>
    </div>
  </div>
</div>
