---
import LanguageSwitch from './LanguageSwitch.astro';
import {
  changelogsUrl,
  englishChangelogsUrl,
  japaneseChangelogsUrl,
} from '../../site-links';

type Props = {
  lang?: 'zh-CN' | 'en' | 'ja';
  active?: 'home' | 'docs' | 'blog' | 'changelogs';
};

const { lang = 'zh-CN', active = 'home' } = Astro.props;
const isEnglish = lang === 'en';
const isJapanese = lang === 'ja';
const prefix = isEnglish ? '/en' : isJapanese ? '/ja' : '';
const navLabel = isEnglish ? 'Main navigation' : isJapanese ? 'メインナビゲーション' : '主导航';
const homeUrl = prefix ? `${prefix}/` : '/';
const navLinks = [
  { key: 'home', label: isEnglish ? 'Home' : isJapanese ? 'ホーム' : '首页', href: homeUrl },
  {
    key: 'docs',
    label: isEnglish ? 'Docs' : isJapanese ? 'ドキュメント' : '文档',
    href: `${prefix}/docs/`,
  },
  { key: 'blog', label: isEnglish ? 'Blog' : isJapanese ? 'ブログ' : '博客', href: `${prefix}/blog/` },
  {
    key: 'changelogs',
    label: isEnglish ? 'Release Notes' : isJapanese ? '更新履歴' : '更新日志',
    href: isEnglish
      ? englishChangelogsUrl
      : isJapanese
        ? japaneseChangelogsUrl
        : changelogsUrl,
  },
] as const;
---

<header class="mh">
  <div class="lp-container">
    <div class="mh-bar">
      <a class="mh-wordmark" href={homeUrl}>
        <span class="mh-title">Yomitomo</span>
      </a>
    </div>
    <nav class="mh-nav" aria-label={navLabel}>
      {
        navLinks.map((link) => (
          <a class:list={['nav-item', active === link.key && 'is-active']} href={link.href}>
            {link.label}
          </a>
        ))
      }
      <span class="nav-spacer"></span>
      <LanguageSwitch lang={lang} menuId="masthead-language-menu" />
    </nav>
  </div>
</header>
<header class="mh-float" data-float-bar>
  <a class="mh-float-brand" href={homeUrl}>
    <img src="/assets/yomitomo-logo-96.png" alt="" width="28" height="28" />
    <span>Yomitomo</span>
  </a>
  <nav class="mh-float-nav" aria-label={navLabel}>
    {
      navLinks.map((link) => (
        <a class:list={['nav-item', active === link.key && 'is-active']} href={link.href}>
          {link.label}
        </a>
      ))
    }
  </nav>
  <LanguageSwitch lang={lang} menuId="float-language-menu" />
</header>
