{
  "name": "@yomitomo/telemetry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:worker": "wrangler dev",
    "deploy:cf": "wrangler deploy",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src --type-aware",
    "lint:fix": "oxlint src --fix",
    "format": "oxfmt --write \"src/**/*.ts\" package.json tsconfig.json wrangler.jsonc",
    "format:check": "oxfmt --check \"src/**/*.ts\" package.json tsconfig.json wrangler.jsonc",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@yomitomo/shared": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260823.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
