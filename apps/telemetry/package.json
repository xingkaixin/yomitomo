{
  "name": "@yomitomo/telemetry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:worker": "cf dev",
    "deploy:cf": "cf deploy",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src --type-aware",
    "lint:fix": "oxlint src --fix",
    "format": "oxfmt --write \"src/**/*.ts\" package.json tsconfig.json cloudflare.config.ts wrangler.config.ts",
    "format:check": "oxfmt --check \"src/**/*.ts\" package.json tsconfig.json cloudflare.config.ts wrangler.config.ts",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@yomitomo/shared": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
