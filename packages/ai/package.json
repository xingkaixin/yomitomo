{
  "name": "@yomitomo/ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "evaluate:semantic": "node scripts/evaluate-semantic-retrieval.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint . --type-aware",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --write \"**/*.{ts,tsx,js,jsx,json,css,html}\"",
    "format:check": "oxfmt --check \"**/*.{ts,tsx,js,jsx,json,css,html}\"",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.69",
    "@ai-sdk/google": "^4.0.86",
    "@ai-sdk/openai": "^4.0.82",
    "@ai-sdk/openai-compatible": "^3.0.60",
    "@yomitomo/core": "workspace:*",
    "@yomitomo/shared": "workspace:*",
    "ai": "^7.0.123",
    "effect": "4.0.0"
  },
  "devDependencies": {
    "@huggingface/transformers": "4.2.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
